---
// Shared shell for the willaicite landing site: head metadata, masthead,
// colophon, and the whole design system (shared with the audit app's UI).
interface Props {
  title: string;
  description: string;
  /** Absolute canonical URL of this page on the production origin. */
  canonical: string;
  /** JSON-LD graph for this page (rendered verbatim). */
  schema?: object | null;
}
const { title, description, canonical, schema = null } = Astro.props;

// Content date, shown in the masthead/colophon and mirrored in JSON-LD.
export const UPDATED_ISO = '2026-08-07';
export const UPDATED_HUMAN = 'August 7, 2026';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Ryan" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:site_name" content="willaicite" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content="https://willaicite.com/og.png" />
  <meta property="article:modified_time" content={UPDATED_ISO} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>

<div class="mastwrap">
  <div class="sheet">
    <header class="masthead">
      <div class="wordmark"><a href="/">will<span class="ai">ai</span>cite</a></div>
      <div class="masthead-meta">generative engine optimization</div>
      <nav class="mast-nav" aria-label="Site">
        <a href="/about">about</a>
        <a href="/crawlers">crawlers</a>
        <a href="/example">example</a>
        <a href="/audit">audit</a>
      </nav>
    </header>
  </div>
</div>

<slot />

<!-- The retrieval gauge: the scrollbar rebuilt as the instrument this site is
     about. A crawler reads the raw document top to eof; the rail maps that
     depth. Ticks are the page's real section rules, the bracket is the
     viewport's measured extent, the readout reports the section under the
     reading line. Purely a mirror of native scrolling; JS stands it up only
     when a wide fine-pointer viewport leaves margin for it. -->
<div class="scrollrail" id="scrollrail" aria-hidden="true" hidden>
  <div class="rail-gauge">
    <div class="rail-line"></div>
    <div class="rail-thumb"><span class="rail-readout"></span></div>
    <div class="rail-head"></div>
    <div class="rail-ticks"></div>
  </div>
</div>

<div class="sheet">
  <footer class="colophon">
    <span>willaicite &middot; generative engine optimization &middot; <a href="https://github.com/ryanportfolio/willaicite">made by Ryan</a></span>
    <span>
      <a href="/about">about</a> &middot;
      <a href="/crawlers">crawler registry</a> &middot;
      <a href="/example">example</a> &middot;
      <a href="mailto:hello@willaicite.com">contact</a> &middot;
      learn more: <a href="https://arxiv.org/abs/2311.09735">Aggarwal et&nbsp;al. (KDD&nbsp;2024)</a> + <a href="/about">2025&ndash;2026 replications</a>
    </span>
  </footer>
</div>

<style is:global>
  :root {
    --paper: #f4f0e6;
    --paper-raised: #fbf8f1;
    --ink: #1c1914;
    --ink-soft: #4a443a;
    --ink-faint: #6b6357;
    --rule: #d8d0bd;
    --accent: #cf3b1a;
    --accent-soft: #f3ddd4;
    --ok: #2c6e49;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
    --mono: ui-monospace, "Cascadia Code", "SF Mono", Menlo, Consolas, monospace;
    --ease: cubic-bezier(0.22, 0.9, 0.35, 1);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #171511;
      --paper-raised: #201d17;
      --ink: #eae3d2;
      --ink-soft: #b5ac97;
      --ink-faint: #958c79;
      --rule: #383327;
      --accent: #f05a35;
      --accent-soft: #3a2018;
      --ok: #6dbb8f;
    }
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  /* The sheet reads better at the ~140% optical size the editor prefers;
     emulate that browser zoom on large screens. Below 1064px (760px of
     zoomed content) the layout stays 1:1 so tablets and phones keep the
     original scale and the existing 760px breakpoint still governs. */
  @media (min-width: 1064px) {
    html { zoom: 1.4; }
  }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.55;
    background-image: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(128,116,90,0.025) 3px, rgba(128,116,90,0.025) 4px);
  }
  .sheet { max-width: 880px; margin: 0 auto; padding: 0 28px; }
  a { color: inherit; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ---------- masthead ---------- */
  /* Sticky so the nav travels with the reader; the wrap carries the paper
     ground so content scrolls cleanly beneath it. */
  .mastwrap {
    position: sticky; top: 0; z-index: 50;
    background: var(--paper);
    background-image: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(128,116,90,0.025) 3px, rgba(128,116,90,0.025) 4px);
  }
  .masthead {
    display: flex; align-items: baseline; justify-content: space-between; gap: 18px;
    padding: 22px 0 14px; border-bottom: 2px solid var(--ink);
  }
  .wordmark { font-family: var(--mono); font-size: 15px; font-weight: 600; letter-spacing: 0.04em; }
  .wordmark a { text-decoration: none; }
  .wordmark .ai { color: var(--accent); }
  .masthead-meta { font-family: var(--mono); font-size: 11px; color: var(--ink-faint); letter-spacing: 0.06em; text-transform: uppercase; }
  .mast-nav { font-family: var(--mono); font-size: 12px; letter-spacing: 0.05em; display: flex; gap: 16px; }
  .mast-nav a { color: var(--ink-soft); text-decoration: none; }
  .mast-nav a:hover { color: var(--accent); }

  /* ---------- section chrome ---------- */
  .report-rule { margin-top: 72px; border-top: 2px solid var(--ink); position: relative; }
  .report-rule .rulelabel {
    position: absolute; top: -11px; left: 0; background: var(--paper); padding-right: 14px;
    font-family: var(--mono); font-size: 11px; font-weight: 400; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft);
  }
  .section-intro { margin-top: 34px; max-width: 60ch; color: var(--ink-soft); }
  .section-intro a, .body-link { color: var(--ink); text-decoration-color: var(--accent); text-underline-offset: 2px; }
  .section-intro a:hover, .body-link:hover { color: var(--accent); }

  /* ---------- CTA ---------- */
  .cta {
    display: inline-block; background: var(--ink); color: var(--paper);
    font-family: var(--mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase;
    text-decoration: none; padding: 14px 28px; border: 1.5px solid var(--ink);
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .cta:hover { background: var(--accent); border-color: var(--accent); color: #fbf8f1; }
  .fineprint { font-family: var(--mono); font-size: 11.5px; color: var(--ink-faint); }

  /* ---------- colophon ---------- */
  .colophon {
    padding: 20px 0 60px;
    font-family: var(--mono); font-size: 11px; color: var(--ink-faint);
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
  }
  .colophon a { color: var(--ink-soft); }
  .colophon a:hover { color: var(--accent); }

  @media (max-width: 760px) {
    .masthead-meta { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }

  /* ---------- retrieval gauge ---------- */
  /* Contract: every mark is a measured fact of the document (ticks = real
     h2.rulelabel rules, bracket = viewport/document ratio with a 26px grab
     clamp, caps = start and eof, head = the 30%-of-viewport reading line
     that decides the active section); accent marks only the active section
     tick; rail text is mono, lowercase, and limited to the literals "top",
     "eof" and the eof verdict "retrieved in full" plus the page's own
     headings and measured percents; colors come only from the existing
     custom properties. The band carries the page's paper ground so the
     instrument stays legible over the full-bleed ink band, and spans the
     sheet's whole outer margin so the gauge sits at the margin's inner
     edge instead of floating at the viewport edge on wide screens. */
  html.railed { scrollbar-width: none; }
  html.railed::-webkit-scrollbar { width: 0; height: 0; }
  .scrollrail {
    position: fixed; top: 0; bottom: 0; right: 0; width: 54px; z-index: 60;
    background: var(--paper);
    background-image: repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(128,116,90,0.025) 3px, rgba(128,116,90,0.025) 4px);
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.08em; text-transform: lowercase;
    color: var(--ink-faint); user-select: none; -webkit-user-select: none;
  }
  .rail-gauge { position: absolute; top: 12px; bottom: 12px; left: 0; width: 54px; }
  .rail-line { position: absolute; top: 0; bottom: 0; right: 12px; width: 2px; background: var(--rule); }
  .rail-line::before, .rail-line::after {
    content: ''; position: absolute; right: -5px; width: 12px; height: 2px; background: var(--ink-soft);
  }
  .rail-line::before { top: 0; }
  .rail-line::after { bottom: 0; }
  /* Ticks paint above the bracket; the paper halo punches each tick through
     the bracket arms so two measurements never fuse into one mark. */
  .rail-ticks { position: absolute; inset: 0; pointer-events: none; z-index: 2; }
  .tick { position: absolute; right: 8px; width: 12px; height: 14px; cursor: pointer; pointer-events: auto; }
  .tick::before {
    content: ''; position: absolute; right: 0; top: 6px; width: 12px; height: 2px; background: var(--ink-soft);
    box-shadow: 0 0 0 2px var(--paper);
    transition: background 0.15s var(--ease), width 0.15s var(--ease);
  }
  .tick:hover::before { width: 16px; }
  .tick.active::before { background: var(--accent); width: 16px; }
  .tick i {
    position: absolute; top: -1px; right: 16px; writing-mode: vertical-rl;
    font-style: normal; white-space: nowrap; color: var(--ink-soft);
    background: var(--paper); padding: 3px 1px;
    opacity: 0; transition: opacity 0.15s var(--ease); pointer-events: none;
    transform: translateZ(0); /* composited layer forces grayscale AA on rotated glyphs */
  }
  .tick.up i { top: auto; bottom: -1px; }
  .tick:hover i { opacity: 1; }
  .rail-thumb {
    position: absolute; right: 8px; width: 12px; min-height: 26px; cursor: grab; z-index: 1;
    border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink);
    transition: background 0.15s var(--ease);
  }
  .rail-thumb::before, .rail-thumb::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: 2px;
    background: linear-gradient(var(--ink) 5px, transparent 5px calc(100% - 5px), var(--ink) calc(100% - 5px));
  }
  .rail-thumb::before { left: 0; }
  .rail-thumb::after { right: 0; }
  .scrollrail:hover .rail-thumb, .scrollrail.dragging .rail-thumb { background: var(--paper-raised); }
  .scrollrail.dragging .rail-thumb { cursor: grabbing; }
  /* The read head: the fixed reading line inside the bracket that decides
     the active section. Long and faint where ticks are short and dark. */
  .rail-head { position: absolute; right: 2px; width: 20px; height: 1px; background: var(--rule); pointer-events: none; z-index: 1; }
  /* The readout captions the bracket it measures: hangs just below it,
     flips above when the bracket nears the bottom cap. */
  .rail-readout {
    position: absolute; top: calc(100% + 10px); right: 18px; writing-mode: vertical-rl;
    white-space: nowrap; pointer-events: none; background: var(--paper); padding: 3px 1px;
    transform: translateZ(0);
  }
  .rail-thumb.up .rail-readout { top: auto; bottom: calc(100% + 10px); }
  @media (max-width: 1063px) { .scrollrail { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .tick::before, .tick i, .rail-readout, .rail-thumb { transition: none; }
  }
  @media print { .scrollrail { display: none; } }
</style>

<script>
  // Retrieval gauge. Mirrors native scrolling; never intercepts wheel or
  // keyboard input. All geometry is derived as ratios from the layout-space
  // metrics (offsetTop / scrollHeight / clientHeight), which stay mutually
  // consistent under the html zoom applied on large screens.
  const rail = document.getElementById('scrollrail');
  const docEl = document.documentElement;
  if (rail) {
    const gauge = rail.querySelector<HTMLElement>('.rail-gauge')!;
    const ticksLayer = rail.querySelector<HTMLElement>('.rail-ticks')!;
    const thumb = rail.querySelector<HTMLElement>('.rail-thumb')!;
    const head = rail.querySelector<HTMLElement>('.rail-head')!;
    const readout = rail.querySelector<HTMLElement>('.rail-readout')!;
    const mqWide = window.matchMedia('(min-width: 1064px)');
    const mqFine = window.matchMedia('(pointer: fine)');

    type Tick = { el: HTMLElement; lab: HTMLElement; anchor: HTMLElement; label: string; y: number };
    let ticks: Tick[] = [];
    let enabled = false;
    let raf = 0;
    let zoomF = 1;

    const offsetY = (el: HTMLElement): number => {
      let y = 0;
      for (let n: HTMLElement | null = el; n; n = n.offsetParent as HTMLElement | null) y += n.offsetTop;
      return y;
    };
    // Snap a layout-space position to the device pixel grid so nominally
    // identical marks render at identical stroke weight under the html zoom.
    const snap = (v: number): number => Math.round(v * zoomF) / zoomF;
    const pad = (n: number): string => String(n).padStart(2, '0');

    const build = () => {
      ticksLayer.textContent = '';
      ticks = [];
      for (const h of document.querySelectorAll<HTMLElement>('h2.rulelabel')) {
        const anchor = (h.closest('.report-rule, .band-rule') as HTMLElement) ?? h;
        const el = document.createElement('span');
        el.className = 'tick';
        const label = (h.textContent ?? '').trim();
        const i = document.createElement('i');
        i.textContent = label;
        el.appendChild(i);
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const top = Math.max(0, offsetY(anchor) - docEl.clientHeight * 0.18);
          window.scrollTo({ top });
        });
        ticksLayer.appendChild(el);
        ticks.push({ el, lab: i, anchor, label: label.toLowerCase(), y: 0 });
      }
    };

    const layout = () => {
      const H = docEl.scrollHeight;
      const vh = docEl.clientHeight;
      const max = H - vh;
      const g = gauge.offsetHeight;
      if (H <= 0 || g <= 0) return;
      for (const t of ticks) {
        t.y = offsetY(t.anchor);
        const frac = t.y / H;
        // Snap the 2px bar itself (it sits 6px into the 14px hit box).
        t.el.style.top = `${snap(frac * g - 1) - 6}px`;
        t.el.classList.toggle('up', frac > 0.7);
        // The tick's graduation value: the scroll progress at which this
        // section's rule reaches the reading line. Same scale as the readout.
        const p = max > 0 ? Math.min(100, Math.max(0, Math.round(((t.y - vh * 0.3) / max) * 100))) : 0;
        t.lab.textContent = `${t.label} · ${pad(p)}%`;
      }
    };

    const paint = () => {
      const H = docEl.scrollHeight;
      const vh = docEl.clientHeight;
      const max = H - vh;
      const st = docEl.scrollTop;
      const g = gauge.offsetHeight;
      if (H <= 0 || g <= 0) return;
      const hpx = snap(Math.max((vh / H) * g, 26));
      const tpx = snap(Math.max(0, Math.min((st / H) * g, g - hpx)));
      thumb.style.top = `${tpx}px`;
      thumb.style.height = `${hpx}px`;
      const headY = snap(Math.min(tpx + hpx - 2, tpx + (vh / H) * g * 0.3));
      head.style.top = `${headY}px`;
      const pct = max > 0 ? Math.min(100, Math.max(0, Math.round((st / max) * 100))) : 0;
      const line = st + vh * 0.3;
      let label = 'top';
      let active: Tick | null = null;
      for (const t of ticks) {
        if (t.y <= line) { label = t.label; active = t; }
        t.el.classList.remove('active');
      }
      if (active) active.el.classList.add('active');
      readout.textContent = pct >= 100 ? 'eof · 100% · retrieved in full' : `${label} · ${pad(pct)}%`;
      // Caption stays attached to the bracket: below it, or above near the end.
      thumb.classList.toggle('up', tpx + hpx + readout.offsetHeight + 14 > g);
    };

    const schedule = () => {
      if (raf) return;
      raf = requestAnimationFrame(() => { raf = 0; paint(); });
    };

    // Stand up only when the viewport leaves real margin beside the sheet
    // (measured with the native scrollbar hidden, with hysteresis so the
    // gauge does not flap at the threshold) and the page actually scrolls.
    const evaluate = () => {
      let on = false;
      if (mqWide.matches && mqFine.matches) {
        const sheet = document.querySelector<HTMLElement>('.sheet');
        const H = docEl.scrollHeight;
        const vh = docEl.clientHeight;
        if (sheet && H - vh > vh * 0.5) {
          docEl.classList.add('railed');
          // Measure the free margin beside the sheet in ONE coordinate space.
          // Under the html zoom, root clientWidth/innerWidth stay in visual
          // pixels while offsetWidth is in zoomed layout pixels; mixing them
          // overstates the margin and stands the rail up over the content.
          // innerWidth and getBoundingClientRect are both visual, so divide
          // by the computed zoom to compare against layout-space thresholds.
          const zoom = parseFloat(getComputedStyle(docEl).zoom) || 1;
          zoomF = zoom;
          const margin = (window.innerWidth - sheet.getBoundingClientRect().width) / 2 / zoom;
          on = margin >= (enabled ? 34 : 40);
          // The strip spans the sheet's whole outer margin; the gauge sits
          // left-anchored at its inner edge, so on wide screens the
          // instrument stays beside the sheet, not at the viewport edge.
          if (on) rail.style.width = `${Math.max(54, Math.floor(margin) - 16)}px`;
        }
      }
      docEl.classList.toggle('railed', on);
      rail.hidden = !on;
      enabled = on;
      if (on) { layout(); paint(); }
    };

    let dragId = -1;
    let grab = 0;
    thumb.addEventListener('pointerdown', (e) => {
      dragId = e.pointerId;
      thumb.setPointerCapture(dragId);
      grab = e.clientY - thumb.getBoundingClientRect().top;
      rail.classList.add('dragging');
      e.preventDefault();
    });
    thumb.addEventListener('pointermove', (e) => {
      if (e.pointerId !== dragId) return;
      const gr = gauge.getBoundingClientRect();
      const tr = thumb.getBoundingClientRect();
      const span = gr.height - tr.height;
      if (span <= 0) return;
      const frac = Math.min(1, Math.max(0, (e.clientY - gr.top - grab) / span));
      window.scrollTo({ top: frac * (docEl.scrollHeight - docEl.clientHeight), behavior: 'instant' });
    });
    const endDrag = (e: PointerEvent) => {
      if (e.pointerId !== dragId) return;
      dragId = -1;
      rail.classList.remove('dragging');
    };
    thumb.addEventListener('pointerup', endDrag);
    thumb.addEventListener('pointercancel', endDrag);
    rail.addEventListener('click', (e) => {
      if (thumb.contains(e.target as Node)) return;
      const gr = gauge.getBoundingClientRect();
      if (gr.height <= 0) return;
      const frac = Math.min(1, Math.max(0, (e.clientY - gr.top) / gr.height));
      const top = Math.max(0, frac * docEl.scrollHeight - docEl.clientHeight / 2);
      window.scrollTo({ top });
    });

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', evaluate);
    window.addEventListener('load', evaluate);
    window.addEventListener('pageshow', () => { if (enabled) paint(); });
    mqWide.addEventListener('change', evaluate);
    mqFine.addEventListener('change', evaluate);
    if (document.fonts?.ready) document.fonts.ready.then(evaluate);
    build();
    evaluate();
  }
</script>
</body>
</html>
